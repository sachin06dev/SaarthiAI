# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# AI Provider Configuration (Default: mock for zero-key boot)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Document Extraction Provider (Default: local/synthetic mock)
OCR_PROVIDER=local
OCR_API_KEY=

# Optional Persistence (Only configure if stored bookings/reports are needed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upload & Privacy Guardrails
MAX_UPLOAD_MB=20
MAX_FILES_PER_SESSION=10
MAX_PDF_PAGES=30
REPORT_RETENTION_HOURS=1
